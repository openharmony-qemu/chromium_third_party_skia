+            return false;
+        }
         lattice->fRectTypes = buffer.skipT<SkCanvas::Lattice::RectType>(flagCount);
         lattice->fColors = buffer.skipT<SkColor>(flagCount);
     }
     lattice->fBounds = buffer.skipT<SkIRect>();
     return buffer.isValid();
